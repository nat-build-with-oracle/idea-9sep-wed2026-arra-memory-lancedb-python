{
  "name": "arra-memory-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Arra Memory web UI, built into ../arra_memory/static for the Python server to serve.",
  "scripts": {
    "build": "bun run build:js && bun run build:css && bun run build:html",
    "build:js": "bun build src/ui/main.tsx --outdir ../arra_memory/static --minify --target browser",
    "build:css": "bun node_modules/@tailwindcss/cli/dist/index.mjs -i src/ui/app.css -o ../arra_memory/static/app.css --minify",
    "build:html": "cp public/index.html ../arra_memory/static/index.html",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0"
  }
}
