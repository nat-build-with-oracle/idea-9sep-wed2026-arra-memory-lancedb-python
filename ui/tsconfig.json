{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,

    // React for the client bundle. The one server-rendered page opts out with a
    // per-file `@jsxImportSource @kitajs/html` pragma, because it compiles to a
    // string rather than a React tree.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*"]
}
