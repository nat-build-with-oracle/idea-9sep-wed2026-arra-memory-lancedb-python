# Copy to .env (git-ignored) or export these. Never commit real values.
# The only required one. Generate with: openssl rand -base64 32
OWNER_PASSPHRASE=replace-with-a-long-random-passphrase

# Optional static bearer for scripts and CLI MCP clients. Blank disables that door.
# API_TOKEN=

# Optional. Semantic search via any Ollama you already run — it need not be this machine.
# OLLAMA_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024

# Optional. Absolute origin, for when this is published through a proxy or a tunnel.
# PUBLIC_URL=https://memory.example.com

# Where the corpus, the settings file, and every durable thing live.
# DATA_DIR=./data
